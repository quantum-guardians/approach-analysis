# poster-batch environment
# Redis connection (default: redis://localhost:6379/0)
POSTER_REDIS_URL=redis://localhost:6379/0

# Redis queue name (default: poster-results)
POSTER_BATCH_QUEUE=poster-results

# S3 bucket for result chunks (required for worker/collect)
POSTER_S3_BUCKET=

# S3 key prefix (default: poster-batch)
POSTER_S3_PREFIX=poster-batch

# AWS region
AWS_REGION=ap-northeast-2
